# SmartScroll API Configuration
# Reddit API — create an app at https://www.reddit.com/prefs/apps (type: script)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=your_app_name/1.0 by your_reddit_username

# YouTube API — create a key at https://console.cloud.google.com (enable YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_api_key

# OpenAI API — create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Twilio (video conferencing) — get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret

# App Configuration
APP_NAME=smartscrolling
APP_DESCRIPTION=Smart educational content feed with AI summarization
REDIRECT_URI=http://localhost:3000/posts.html

# Development Settings
NODE_ENV=development
PORT=3000
CORS_PROXY_PORT=3002
