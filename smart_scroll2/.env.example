# SmartScroll configuration. Copy to .env (gitignored) and fill in real values:
#   cp .env.example .env
# docker-compose.yml loads this file into the cors-proxy and token-server containers.
# Every variable is optional: a missing one disables that feature
# (Reddit falls back to the public endpoint, /ai/chat returns 503, /token returns 500).

# --- cors-proxy: Reddit search (OAuth2 client-credentials, kept server-side) ---
# Create an app (type: script) at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
# Optional. Default: SmartScroll/1.0
REDDIT_USER_AGENT=your_app_name/1.0 by your_reddit_username

# --- cors-proxy: AI summaries, quizzes, document Q&A (via OpenRouter) ---
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional. Default (in web/cors-proxy.js): deepseek/deepseek-v4-flash-0731
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# --- token-server: Twilio Video access tokens (video conferencing) ---
# Create an API key at https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret

# NOTE: the YouTube Data API key is not read from this file. It is a
# browser-side constant (YOUTUBE_API_KEY) in web/feed.html and ships to every
# visitor, so restrict it by HTTP referrer and API in the Google Cloud console.
