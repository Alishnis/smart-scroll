server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # HTML, JS and CSS change often during development and are small —
    # always revalidate instead of letting browsers cache them silently.
    location ~* \.(?:html|js|css)$ {
        add_header Cache-Control "no-cache";
    }

    # Static assets (images, fonts) rarely change and are fine to cache.
    location ~* \.(?:png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        add_header Cache-Control "public, max-age=604800";
    }

    # Reverse-proxy the API paths to cors-proxy so the browser can call
    # same-origin relative URLs instead of a hardcoded localhost:3002 —
    # CORS_PROXY_HOST is "cors-proxy" under docker-compose (service DNS)
    # and "localhost" when both containers share a network namespace
    # (e.g. Azure Container Instances).
    location /reddit/ {
        proxy_pass http://${CORS_PROXY_HOST}:3002/reddit/;
    }

    location /ai/ {
        proxy_pass http://${CORS_PROXY_HOST}:3002/ai/;
    }

    location /proxy {
        proxy_pass http://${CORS_PROXY_HOST}:3002/proxy;
    }

    # Twilio video access-token server — same relative-URL reasoning as above.
    location /token {
        proxy_pass http://${TOKEN_SERVER_HOST}:3007/token;
    }
}
